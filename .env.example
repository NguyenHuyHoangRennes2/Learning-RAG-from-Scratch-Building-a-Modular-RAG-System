# Modèle de configuration locale.
# Copier ce fichier en .env puis adapter les valeurs :  Copy-Item .env.example .env
# Toutes les variables sont optionnelles : sans .env, les valeurs par défaut
# définies dans app/core/config.py s'appliquent.
# Le fichier .env ne doit JAMAIS être commité (il pourra contenir des secrets).

# Niveau de log : DEBUG, INFO, WARNING, ERROR, CRITICAL
RAG_LOG_LEVEL=INFO

# Chemins (relatifs à la racine du projet, ou absolus)
# RAG_RAW_DATA_DIR=data/raw
# RAG_PROCESSED_DATA_DIR=data/processed
# RAG_CHROMA_DIR=storage/chroma

# Chunking : taille max d'un chunk et chevauchement (en caractères), stratégie (fixed | sentence)
# Règle : RAG_CHUNK_OVERLAP doit être strictement inférieur à RAG_CHUNK_SIZE
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=150
# RAG_CHUNK_STRATEGY=sentence

# Embeddings : modèle Sentence Transformers (téléchargé depuis Hugging Face au 1er lancement),
# matériel de calcul (cpu | cuda) et taille des lots
# ATTENTION : changer de modèle impose de réindexer tous les documents (vecteurs incompatibles)
# RAG_EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
# RAG_EMBEDDING_DEVICE=cpu
# RAG_EMBEDDING_BATCH_SIZE=32

# Base vectorielle : nom de la collection ChromaDB (stockée dans RAG_CHROMA_DIR)
# RAG_CHROMA_COLLECTION_NAME=rag_chunks
